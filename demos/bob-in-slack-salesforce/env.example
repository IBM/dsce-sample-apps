# Copy to .env. Never commit .env. Every variable the service reads is listed;
# blank means required for the feature named in the comment.

# --- Bob ---------------------------------------------------------------------
BOBSHELL_API_KEY=                 # Bob Shell API key (the only secret Bob ever sees)
HB_BOB_BIN=bob                    # Bob Shell executable
HB_SEED_DIR=/app/seeds/salesforce # workspace seed: custom mode + skills copied into every session
HB_BOB_DISABLE_SUBAGENTS=1        # subagents off (default); set 0 to allow delegation
HB_BOB_DISABLE_MCP=0              # MCP on (default); set 1 to disable MCP servers
HB_BOB_ENV_EXTRA=                 # extra env names Bob may see, comma-separated; a trailing * allows a prefix

# --- Service -----------------------------------------------------------------
HB_ROOT=/workspace                # tenant homes + session workspaces (persistent volume in production)
HB_DB=/workspace/headless-bob.db  # SQLite: jobs, sessions, api keys, case flow
HB_WORKERS=3                      # concurrent Bob turns
PORT=8080

# --- Slack app (docs/slack-app-setup.md) --------------------------------------
HB_SLACK_BOT_TOKEN=               # xoxb-… from the app's OAuth page
HB_SLACK_SIGNING_SECRET=          # from the app's Basic Information page
HB_SLACK_SESSION_SCOPE=channel    # channel: one conversation per channel (case flow); thread: per thread
HB_SLACK_MODE=                    # Bob mode for free-form questions; empty = Bob's default (agent), same as the case turns
HB_SLACK_MAX_COST=0.50            # Bob cost cap per conversation (one session, cumulative over its turns)
HB_SLACK_MAX_COST_PER_DAY=5.00    # Bob cost cap per day across all conversations
HB_SLACK_TIMEOUT=300              # seconds per Slack turn
HB_SLACK_TEAM_ID=                 # optional; resolved from the token when empty (deep links)
HB_SLACK_AUTO_JOIN=0              # 1 = the bot joins every new public channel
HB_PO_SLACK_USER_IDS=             # comma-separated member IDs auto-invited to each case channel

# --- Salesforce org (docs/salesforce-setup.md) -------------------------------
HB_SF_LOGIN_URL=https://login.salesforce.com
HB_SF_CLIENT_ID=                  # External Client App consumer key
HB_SF_USERNAME=                   # integration user the service acts as
HB_SF_PRIVATE_KEY_B64=            # base64 of the private key matching the app's certificate

# --- Case flow ----------------------------------------------------------------
HB_FLOW_VARIANT=successplan       # successplan | validation_rule (predefined change) | package (Bob builds the change)
HB_MCP_URL=                       # package variant: where Bob reaches this service's read-only org tools; default http://127.0.0.1:$PORT/mcp (Bob runs in the same container)
HB_MCP_TOKEN=                     # package variant: bearer token for that endpoint (generated per start when empty)
HB_PACKAGE_TYPES=Flow,ApexClass,ApexTrigger,CustomField,ValidationRule,CustomLabel   # metadata types Bob may deploy
HB_PACKAGE_FIX_ATTEMPTS=3         # validation-error fix turns before giving up
HB_PACKAGE_MAX_COST=3.00          # package variant: replaces HB_SLACK_MAX_COST as the per-case session cap (build + fix turns)
HB_CASE_REQUESTER_EMAIL=          # the case's requester; receives the closure email (empty = no email)
HB_CASE_OWNER_USERNAME=           # optional: username that owns created cases
HB_DEMO_OPP_NAME=Meridian Renewal # the deal closed as Won to prove the Flow
HB_ATTRACT_LOOP=0                 # 1 = always keep one open sample case waiting in Slack
HB_LOOP_DELAY_SECONDS=15          # pause before the next sample case after a close
HB_CASEFLOW_IDLE_MINUTES=60       # abandoned cases are closed and recycled after this
HB_SWEEP_HOURS=                   # e.g. 7-19: only recycle abandoned cases in these local hours
HB_ARCHIVE_DELAY_SECONDS=0        # grace period before a closed case's channel is archived

# --- Closure email (optional) -------------------------------------------------
HB_MAIL_TRANSPORT=                # smtp | gmail | empty (no email)
HB_MAIL_FROM=
HB_SMTP_HOST=
HB_SMTP_PORT=587
HB_SMTP_USER=
HB_SMTP_PASSWORD=
HB_GMAIL_CLIENT_ID=
HB_GMAIL_CLIENT_SECRET=
HB_GMAIL_REFRESH_TOKEN=

# --- scripts/deploy.sh (IBM Cloud Code Engine example) -----------------------
IBMCLOUD_API_KEY=
CE_REGION=us-south
CE_RESOURCE_GROUP=
CE_PROJECT=
CE_APP=bob-in-slack
IMAGE=us.icr.io/<namespace>/bob-in-slack
