# backend/.env.example
# Copy to backend/.env and fill in values for local/podman testing.
# The backend reads this file automatically via pydantic-settings.
# NEVER commit the real backend/.env to source control.
#
#   cp backend/.env.example backend/.env

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
LOG_LEVEL=info

# ── Demo login (used by POST /api/auth/login) ─────────────────────────────────
# Set these via environment variables or Code Engine secrets before running.
DEMO_USERNAME=CHANGE_ME
DEMO_PASSWORD=CHANGE_ME

# ── watsonx Orchestrate (backend-only — never exposed to browser) ─────────────
WXO_BASE_URL=https://api.eu-de.assistant.watson.cloud.ibm.com
WXO_API_KEY=YOUR_WXO_API_KEY_HERE
# WXO_AGENT_ID=YOUR_WXO_AGENT_ID_HERE   # optional, auto-discovered if omitted

# ── OpenSearch / RAG (optional — leave blank to run without RAG) ──────────────
# OPENSEARCH_HOST=http://localhost:9200
# OPENSEARCH_USERNAME=admin
# OPENSEARCH_PASSWORD=

# ── Confluent (optional — leave blank to run without Kafka) ───────────────────
# CONFLUENT_BOOTSTRAP_SERVERS=
# CONFLUENT_API_KEY=
# CONFLUENT_API_SECRET=
# CONFLUENT_SCHEMA_REGISTRY_URL=
# CONFLUENT_SCHEMA_REGISTRY_API_KEY=
# CONFLUENT_SCHEMA_REGISTRY_API_SECRET=
