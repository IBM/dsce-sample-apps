# ui/.env.example
# Copy to .env.local and fill in values as needed.
# NEVER commit .env.local to source control.
#
# With the server-side IAM exchange in place, the IBM Cloud API key and WXO
# instance URL are held as Code Engine secrets on the BACKEND, not here.
# The UI no longer needs VITE_WXO_API_KEY or VITE_WXO_BASE_URL.

# ── Optional: override agent names if you deploy under different names ─────────

# Name of the primary TSCI orchestrator agent registered in wxO.
# Must match the 'name' field in wxo/agents/tsci_primary_agent.yaml
# Default: tsci_primary_agent
# VITE_WXO_AGENT_NAME=tsci_primary_agent

# Name of the CRAG agent deployed via:
#   bash continuous_rag/wxo_confluent_mcp/deploy.sh
# Must match the 'name' field in:
#   continuous_rag/wxo_confluent_mcp/agents/native/confluent_rag_agent_v1.yaml
# Default: crag_rag_agent_v1
# VITE_WXO_CRAG_AGENT_NAME=crag_rag_agent_v1

# ── Backend secrets (set on the BACKEND service, not here) ────────────────────
# WXO_API_KEY      — IBM Cloud API key used to obtain IAM Bearer tokens
# WXO_BASE_URL     — watsonx Orchestrate instance URL
# These are Code Engine secrets injected as env vars into the backend container.
# The UI retrieves a short-lived Bearer token from GET /api/auth/wxo-token.
