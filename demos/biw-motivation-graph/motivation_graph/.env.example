# BIW Motivation Graph — environment variable template
# ======================================================
# Copy this file to .env (project root or motivation_graph/) and fill in the
# values for the IBM services you are targeting.  The pipeline runs in OSS
# fallback mode (local Docker Compose) for any service whose vars are absent.
#
# .env is .gitignore'd — never commit credentials.
#
# Run the reachability gate after filling in any section:
#   python -c "from ibm_services import IBMServiceManager; IBMServiceManager().run_reachability_gate()"
# Any "reachable: no" line must be resolved before that service is used on camera.

# ── IBM Cloud Object Storage (IBM COS) ────────────────────────────────────────
#
# OSS fallback: local MinIO container (docker compose up -d).
# Set ALL four COS_* vars to activate IBM COS; leave empty to keep MinIO.
#
# 1. Create a Cloud Object Storage instance in IBM Cloud.
# 2. Create a bucket in the desired region.
# 3. Under "Service credentials", create a new credential with HMAC enabled.
#    The credential JSON will contain an "cos_hmac_keys" block:
#      "cos_hmac_keys": { "access_key_id": "...", "secret_access_key": "..." }
# 4. Fill in the values below.
#
# Endpoint formats (choose based on network):
#   Public:   https://s3.<region>.cloud-object-storage.appdomain.cloud
#   Private:  https://s3.private.<region>.cloud-object-storage.appdomain.cloud
#   Direct:   https://s3.direct.<region>.cloud-object-storage.appdomain.cloud
# Common regions: us-south, us-east, eu-de, eu-gb, jp-tok, au-syd

COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_ACCESS_KEY=<your-hmac-access-key-id>
COS_SECRET_KEY=<your-hmac-secret-access-key>
COS_BUCKET=watsonx-data-531da588-ba12-4838-8b89-b758d3685189
COS_REGION=us-south
# COS_PATH_STYLE defaults to true (required for IBM COS HMAC); leave unset.
# COS_PATH_STYLE=true

# After setting the above, also update trino-config/catalog/iceberg.properties
# and trino-config/catalog/databricks.properties with the same endpoint/key
# values (Trino does not support env-var substitution in catalog properties).

# ── Iceberg REST catalog ───────────────────────────────────────────────────────
# OSS fallback: http://localhost:8181 (tabulario/iceberg-rest in Docker Compose)
# IBM: watsonx.data catalog endpoint (obtain from your watsonx.data instance)
# ICEBERG_REST_URI=https://<watsonx-data-catalog-host>/v1

# ── watsonx.data / Trino (IBM: watsonx.data Presto engine) ────────────────────
WATSONX_DATA_HOST=<your-instance>.lakehouse.ibmappdomain.cloud
WATSONX_DATA_PORT=30186
WATSONX_DATA_USER=<ibmid-email>
WATSONX_AI_API_KEY=<iam-api-key>
WATSONX_DATA_CATALOG=iceberg
WATSONX_DATA_SCHEMA=biw

# Trino connection — defaults to WATSONX_DATA_HOST above when set.
# Set TRINO_HOST explicitly only if your Presto endpoint differs from
# WATSONX_DATA_HOST (e.g. separate cluster or port).
# TRINO_HOST=<same-as-WATSONX_DATA_HOST>
# TRINO_PORT=30186
# TRINO_USER=<same-as-WATSONX_DATA_USER>
# TRINO_PASSWORD=<same-as-WATSONX_DATA_PASSWORD>
# TRINO_TLS=true

# ── IBM Confluent (Kafka) ──────────────────────────────────────────────────────
# OSS fallback: localhost:9092 (confluentinc/cp-kafka in Docker Compose)
CONFLUENT_BOOTSTRAP_SERVERS=<broker>.confluent.cloud:9092
CONFLUENT_SECURITY_PROTOCOL=SASL_SSL
CONFLUENT_SASL_MECHANISM=PLAIN
CONFLUENT_SASL_USERNAME=<confluent-api-key>
CONFLUENT_SASL_PASSWORD=<confluent-api-secret>

# ── IBM DataStax Enterprise (Cassandra) ───────────────────────────────────────
# OSS fallback: localhost:9042 (cassandra:5.0 in Docker Compose)
DATASTAX_CONTACT_POINTS=<dse-host>
DATASTAX_PORT=9042
DATASTAX_KEYSPACE=biw_live
DATASTAX_USERNAME=<dse-user>
DATASTAX_PASSWORD=<dse-password>
# DATASTAX_TLS=true

# ── Databricks Delta interop (B4 — read in place, zero copy) ──────────────────
# OSS fallback: local Iceberg REST namespace seeded by streaming/setup_databricks.py
# Real mode: Unity Catalog Iceberg REST endpoint
DATABRICKS_HOST=<workspace>.azuredatabricks.net
DATABRICKS_TOKEN=<personal-access-token>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_ICEBERG_REST_URI=https://<workspace>.azuredatabricks.net/api/2.1/unity-catalog/iceberg
DATABRICKS_ICEBERG_WAREHOUSE=<unity-catalog-name>
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=biw_demo
DATABRICKS_TABLE=seller_history

# ── watsonx.ai ────────────────────────────────────────────────────────────────
WATSONX_AI_API_KEY=<iam-api-key>
WATSONX_AI_PROJECT_ID=<project-guid>
WATSONX_REGION=us-south
# WATSONX_AI_MODEL=granite-3-8b-instruct
# WATSONX_AI_URL=https://us-south.ml.cloud.ibm.com

# ── watsonx Orchestrate (optional) ────────────────────────────────────────────
# WATSONX_ORCHESTRATE_URL=https://<env-id>.orchestrate.ibm.com
# WATSONX_ORCHESTRATE_API_KEY=<api-key>
# WATSONX_ORCHESTRATE_ENV_ID=<env-id>

# ── watsonx.governance (optional) ─────────────────────────────────────────────
# WATSONX_GOVERNANCE_URL=https://dataplatform.cloud.ibm.com
# WATSONX_GOVERNANCE_API_KEY=<iam-api-key>
# WATSONX_GOVERNANCE_SPACE_ID=<space-or-inventory-guid>

# ── Misc ───────────────────────────────────────────────────────────────────────
# SEED=20260812
# LOCAL_DB_PATH=motivation_graph/data/motivation_graph.duckdb
