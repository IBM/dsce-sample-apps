        txn_type           VARCHAR,
        points             BIGINT,
        ts                 TIMESTAMP,
        catalog_item_id    VARCHAR,
        funding_account_id VARCHAR
    )
2026-08-03T20:35:26Z | 20260803_203525_07154_c3pqx | CREATE TABLE marketplace_catalog (
