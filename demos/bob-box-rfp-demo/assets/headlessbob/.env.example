# Copy to .env; never commit credentials.
BOB_API_KEY=
# Map stable caller names to unique random tokens, each at least 24 characters.
# AUTH_TOKENS='{"owner":"replace-with-a-long-random-token"}'
HOST=127.0.0.1
PORT=8000
DATA_DIR=.headlessbob
BOB_BIN=bob
BOB_MODE=agent
# Enabled after Bob Shell 2.0.1 was verified with the live smoke test.
BOB_ENABLE_CONTINUATION=true
# The Agent Client Protocol runtime has no verified cost/turn limit controls.
# BOB_MAX_TURNS and BOB_MAX_COST are legacy CLI-runtime settings only.
MAX_CONCURRENT=2
MAX_QUEUED=100
RUN_TIMEOUT_MS=300000
