# Option 1: Permanent Box Client Credentials (No Expiration) - RECOMMENDED
BOX_CLIENT_ID=your_box_client_id_here
BOX_CLIENT_SECRET=your_box_client_secret_here
# Optional if enterprise/user scoped:
# BOX_ENTERPRISE_ID=your_enterprise_id_here
# BOX_USER_ID=your_user_id_here

# Option 2: 60-Minute Box Developer Token (Manual Refresh)
# BOX_DEV_TOKEN=your_box_developer_token_here

# Headless Bob Configuration
HEADLESSBOB_URL=http://127.0.0.1:8000
HEADLESSBOB_TOKEN=your_service_token_here
