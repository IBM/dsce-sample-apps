# =============================================================================
# SOC — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# IBM watsonx Orchestrate (used by both import-all.sh and server/server.js)
# WXO_ENV_NAME: any short label for the WxO environment (e.g. "soc_dev")
# WXO_URL:      your instance URL
# WXO_API_KEY:  IBM Cloud API key with WxO Manager role
# -----------------------------------------------------------------------------
WXO_ENV_NAME=<your-env-name>
WXO_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<your-instance-uuid>
WXO_API_KEY=<your-ibm-cloud-api-key>

# -----------------------------------------------------------------------------
# Express server port (optional — defaults to 3001)
# -----------------------------------------------------------------------------
EXPRESS_PORT=3001

# -----------------------------------------------------------------------------
# Allowed origin for CORS and /api/wxo-token origin check (optional)
# Defaults to http://localhost:3000 if not set.
# In production set this to the exact deployed URL, e.g. https://soc-demo.example.com
# -----------------------------------------------------------------------------
ALLOWED_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# WxO Conversational Supervisor Agent ID (optional)
# Used by the /api/chat-conv route (chatbot widget).
# If not set, the server falls back to empty string (agent must exist in WxO).
# -----------------------------------------------------------------------------
CONV_SUPERVISOR_AGENT_ID=<conversational-supervisor-agent-uuid>

# -----------------------------------------------------------------------------
# WxO Stage Agent IDs — used by the Express server (server/server.js)
# -----------------------------------------------------------------------------
TRIAGE_AGENT_ID=<triage-agent-uuid>
CLASSIFICATION_AGENT_ID=<classification-agent-uuid>
RCA_AGENT_ID=<rca-agent-uuid>
NOTIFICATION_AGENT_ID=<notification-agent-uuid>
ACTION_AGENT_ID=<action-agent-uuid>
CLOSE_AGENT_ID=<close-agent-uuid>

# -----------------------------------------------------------------------------
# WxO Stage Agent IDs — used by the Next.js frontend (src/data/defaultStages.ts)
# NEXT_PUBLIC_ prefix exposes these to the browser bundle; set only non-secret IDs here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TRIAGE_AGENT_ID=<triage-agent-uuid>
NEXT_PUBLIC_CLASSIFICATION_AGENT_ID=<classification-agent-uuid>
NEXT_PUBLIC_RCA_AGENT_ID=<rca-agent-uuid>
NEXT_PUBLIC_NOTIFICATION_AGENT_ID=<notification-agent-uuid>
NEXT_PUBLIC_ACTION_AGENT_ID=<action-agent-uuid>
NEXT_PUBLIC_CLOSE_AGENT_ID=<close-agent-uuid>

# -----------------------------------------------------------------------------
# IBM Cloud Object Storage (used by import-all.sh bootstrap)
# -----------------------------------------------------------------------------
COS_API_KEY="<your-cos-api-key>"
COS_INSTANCE_CRN="<your-cos-instance-crn>"
COS_ENDPOINT="https://s3.<region>.cloud-object-storage.appdomain.cloud"
COS_BUCKET="<your-cos-bucket-name>"

# -----------------------------------------------------------------------------
# Mailjet (used by import-all.sh bootstrap and notify_tool.py)
# -----------------------------------------------------------------------------
MAILJET_API_KEY="<your-mailjet-api-key>"
MAILJET_SECRET_KEY="<your-mailjet-secret-key>"

# -----------------------------------------------------------------------------
# import-all.sh behaviour (optional)
# Set to "true" to upload YAML config files to COS during bootstrap.
# Default: false (assumes config files are already in COS).
# -----------------------------------------------------------------------------

