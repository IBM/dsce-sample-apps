FROM registry.access.redhat.com/ubi9/nodejs-22:latest AS builder

WORKDIR /app
COPY --chown=1001:0 package*.json ./
RUN npm ci --omit=dev

FROM registry.access.redhat.com/ubi9/nodejs-22-minimal:latest

WORKDIR /app

COPY --chown=1001:0 --from=builder /app/node_modules ./node_modules
COPY --chown=1001:0 server/ ./server/
COPY --chown=1001:0 agents/ ./agents/
COPY --chown=1001:0 tools/ ./tools/
COPY --chown=1001:0 connections/ ./connections/
COPY --chown=1001:0 config/ ./config/
COPY --chown=1001:0 knowledge_base/ ./knowledge_base/

USER 1001:0
EXPOSE 3001

ENV EXPRESS_PORT=3001
ENV NODE_ENV=production

CMD ["node", "server/server.js"]
