# ============================================================
# scripts/.env.example
# Copy to .env and fill in real values before running.
# .env is gitignored — never commit real credentials.
# ============================================================

# AstraDB — database: contract_review / collection: contract_collection
ASTRA_DB_API_ENDPOINT=https://<your-astra-db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:<your-token>
ASTRA_DB_COLLECTION=contract_collection
