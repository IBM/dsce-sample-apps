# ============================================================
# search_contract_clause — .env.example
# Copy to .env and fill in real values before running locally.
# On Code Engine / OpenShift inject these as env vars directly.
# Never commit .env with real credentials.
# ============================================================

ASTRA_DB_API_ENDPOINT=https://<your-astra-db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:<your-token>
ASTRA_DB_COLLECTION=contract_collection

# Shared secret callers must send in the X-API-Key header (min 24 chars).
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Required — the service will not start without it.
SERVICE_API_KEY=
