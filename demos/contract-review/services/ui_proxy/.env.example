# watsonx Orchestrate instance base URL
# e.g. https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/<id>
WXO_BASE_URL=

# API key for authenticating to WXO (IAM API key or WXO user API key)
WXO_API_KEY=

# UUID of the contract_reviewer native agent (parent agent UUID — used by evaluation API)
# Distinct from agentEnvironmentId (used only by the webchat embed script)
# agentId:            <your-agent-id>
# agentEnvironmentId: <your-agent-environment-id>  (webchat only — not used here)
WXO_AGENT_ID=<your-agent-id>

# Access control — sign-in page (session cookie) protecting the UI and every API route.
# UI_PASSWORD is REQUIRED (min 12 chars); the service will not start without it.
UI_USERNAME=reviewer
UI_PASSWORD=

# CORS allowed origin — only needed if the UI is hosted on a different origin.
# Leave empty (same-origin only). A wildcard "*" is ignored.
ALLOWED_ORIGIN=

# ── AstraDB (for vendor contract ingestion) ───────────────────────────────────
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_COLLECTION=contract_collection

# ── IBM COS (for original PDF storage) ───────────────────────────────────────
COS_API_KEY=
COS_SERVICE_INSTANCE_ID=
COS_ENDPOINT=https://s3.us-east.cloud-object-storage.appdomain.cloud
COS_BUCKET=regeneratepdf

# ── Contract defaults ─────────────────────────────────────────────────────────
# Default template_id used when reviewer doesn't specify one
DEFAULT_TEMPLATE_ID=GTA-STANDARD-v1.0
