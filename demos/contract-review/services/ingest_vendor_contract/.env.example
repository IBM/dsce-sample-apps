# ============================================================
# ingest_vendor_contract — .env.example
# Copy to .env and fill in real values before registering.
# On WXO provide these via a key_value Connection.
# Never commit .env with real credentials.
# ============================================================

# AstraDB
ASTRA_DB_API_ENDPOINT=https://<your-astra-db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:<your-token>
ASTRA_DB_COLLECTION=contract_collection

# IBM COS
COS_API_KEY=<your-cos-api-key>
COS_SERVICE_INSTANCE_ID=<your-cos-service-instance-id>
COS_ENDPOINT=https://s3.jp-tok.cloud-object-storage.appdomain.cloud
COS_BUCKET=regeneratepdf2
