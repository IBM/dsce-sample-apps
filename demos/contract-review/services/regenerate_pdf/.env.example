# ============================================================
# regenerate_pdf — .env.example
# Copy to .env and fill in real values before running locally.
# On Code Engine / OpenShift inject these as env vars.
# Never commit .env with real credentials.
# ============================================================

# IBM COS — IAM auth (upload)
COS_API_KEY=<your-cos-api-key>
COS_SERVICE_INSTANCE_ID=<your-cos-service-instance-id>
COS_ENDPOINT=https://s3.jp-tok.cloud-object-storage.appdomain.cloud
COS_BUCKET=regeneratepdf

# IBM COS — HMAC auth (presigned URL generation, optional)
# If not set, a direct COS URL is returned instead of a presigned URL.
COS_HMAC_ACCESS_KEY_ID=<your-hmac-access-key-id>
COS_HMAC_SECRET_ACCESS_KEY=<your-hmac-secret-access-key>

# IBM watsonx.ai — OPTIONAL. Only needed for Path B (natural language instructions).
# Path A (exact find/replace pairs from agent context) works without these.
# Leave blank or omit to disable Path B. Service starts and Path A runs normally.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Shared secret callers must send in the X-API-Key header (min 24 chars).
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Required — the service will not start without it.
SERVICE_API_KEY=
