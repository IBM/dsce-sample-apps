# FleetOps Secret — sensitive credentials
#
# BEFORE APPLYING:
#   1. Base64-encode each value:
#        echo -n 'your-value' | base64
#   2. Replace every <base64-encoded-...> with the encoded output.
#   3. Apply with:
#        oc apply -f openshift-secrets.yaml -n <your-namespace>
#
# WARNING: Never commit this file with real values. Add it to .gitignore.

apiVersion: v1
kind: Secret
metadata:
  name: fleetops-secrets
type: Opaque
data:
  # Instana API token (from your Instana tenant: Settings → API Tokens)
  INSTANA_API_TOKEN: <base64-encoded-instana-api-token>

  # Turbonomic credentials
  TURBONOMIC_USERNAME: <base64-encoded-turbonomic-username>
  TURBONOMIC_PASSWORD: <base64-encoded-turbonomic-password>
