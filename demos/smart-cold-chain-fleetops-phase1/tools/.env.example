# FleetOps Tools — Local Development Environment
#
# These variables are NOT used by the tool files on watsonx Orchestrate.
# On the platform, API URLs are injected via key-value connections (see tools/connections/).
#
# For LOCAL DEVELOPMENT / TESTING outside watsonx Orchestrate, emulate the
# connections by exporting the variables below in your shell before running
# tool scripts.  The WXO_CONNECTION_* naming is the exact convention the
# Orchestrate runtime uses, so the same code path executes in both environments.
#
# Usage:
#   cp tools/.env.example tools/.env
#   # Replace the placeholder URLs with your actual backend hosts
#   set -a && source tools/.env && set +a

# ─── fleetops_api connection (used by station_tool and weather_forecast) ──────
# Emulates: orchestrate connections set-credentials -a fleetops_api --env draft \
#             -e "FLEETOPS_API_URL=..." -e "FLEETOPS_API_BASE_URL=..."
WXO_SECURITY_SCHEMA_fleetops_api=key_value_creds
WXO_CONNECTION_fleetops_api_FLEETOPS_API_URL=https://<your-fleetops-core-api-host>
WXO_CONNECTION_fleetops_api_FLEETOPS_API_BASE_URL=https://<your-fleetops-core-api-host>

# ─── forecast_api connection (used by whatsapp_notification) ──────────────────
# Emulates: orchestrate connections set-credentials -a forecast_api --env draft \
#             -e "FORECAST_API_URL=..."
WXO_SECURITY_SCHEMA_forecast_api=key_value_creds
WXO_CONNECTION_forecast_api_FORECAST_API_URL=https://<your-fleetops-forecasting-api-host>
