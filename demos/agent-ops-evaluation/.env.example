# watsonx Orchestrate instance (IBM Cloud SaaS). Never commit a real .env.
WXO_INSTANCE_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
WXO_API_KEY=<IBM Cloud IAM API key with access to the instance>
# Optional
WXO_ENV_NAME=demo
CHAT_PER_IP_PER_10MIN=12
CHAT_MAX_CONCURRENT=4
JOB_START_COOLDOWN_S=20
JOB_TIMEOUT_S=900
RESULT_FRESH_S=600
