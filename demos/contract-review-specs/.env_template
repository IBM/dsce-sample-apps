# Rename to .env and fill in. Never commit .env. Never put real values in this template.
# Each service also has its own .env.example (see Spec 3 and Spec 4).

# ── watsonx Orchestrate ──────────────────────────────────────────────────────
# PUBLIC: https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
WXO_BASE_URL=
WXO_API_KEY=
WXO_ADK_ENVIRONMENT=ibm_cloud
# Populated by Spec 6 after the agent is imported
WXO_AGENT_ID=

# ── UI proxy sign-in (Spec 4) ────────────────────────────────────────────────
UI_USERNAME=reviewer
# REQUIRED, min 12 characters. The service will not start without it.
UI_PASSWORD=
# Optional external CORS origin. Empty = same-origin only. "*" is ignored.
ALLOWED_ORIGIN=

# ── AstraDB (Spec 1, 2) ──────────────────────────────────────────────────────
# Database: contract_review / Collection: contract_collection
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_COLLECTION=contract_collection

# ── IBM Cloud Object Storage ─────────────────────────────────────────────────
COS_API_KEY=
COS_SERVICE_INSTANCE_ID=
COS_ENDPOINT=https://s3.us-east.cloud-object-storage.appdomain.cloud
COS_BUCKET=regeneratepdf
# Optional: HMAC keys let regenerate_pdf return presigned download URLs
COS_HMAC_ACCESS_KEY_ID=
COS_HMAC_SECRET_ACCESS_KEY=

# ── Tool service shared secrets (Spec 3) ─────────────────────────────────────
# Min 24 chars. Use a DIFFERENT value per service.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SEARCH_SERVICE_API_KEY=
REGENERATE_SERVICE_API_KEY=

# ── Contract defaults ────────────────────────────────────────────────────────
DEFAULT_TEMPLATE_ID=GTA-STANDARD-v1.0

# ── IBM Cloud / deployment (Spec 10, 11) ─────────────────────────────────────
IBMCLOUD_API_KEY=
IBM_CLOUD_RESOURCE_GROUP=
ICR_HOSTNAME=us.icr.io
# If the namespace ends in xxxxxxxx, replace it with a random 8-char [0-9a-z] string on first run
ICR_NAMESPACE=contract-reviewer-xxxxxxxx
CODE_ENGINE_PROJECT=contract-reviewer
OCP_NAMESPACE=contract-reviewer
