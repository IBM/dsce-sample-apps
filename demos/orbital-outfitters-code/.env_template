# ── Product database access ───────────────────────────────────────────────────
DB_HOST=<your-postgres-host>
DB_PORT=<your-postgres-port>
DB_NAME=<your-database-name>
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>
DB_SSL=true
DB_SCHEMA=ai_retail_<8-random-digits>

# ── Secrets ───────────────────────────────────────────────────────────────────
PASSWORD_HASH_SECRET=<change-me-strong-secret>
USER_PASSWORD=<demo-user-password>
JWT_SECRET=<change-me-strong-secret>
SESSION_SECRET=<change-me-strong-secret>

# ── watsonx Orchestrate ───────────────────────────────────────────────────────
WO_INSTANCE_URL=https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/<INSTANCE_ID>
WO_API_KEY=<your-ibm-cloud-api-key>
WO_ADK_ENVIRONMENT=ibm_cloud

# WO: private endpoint reachable via IBM Cloud 166.9.x.x network (no internet egress needed)
WO_INSTANCE_URL_PRIVATE=https://api.private.us-south.watson-orchestrate.cloud.ibm.com/instances/<INSTANCE_ID>

# ── WO Agent IDs (populated after agent deployment) ───────────────────────────
WO_AGENT_ID=<agent-uuid-from-orchestrate-agents-list>

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
BACKEND_SERVER_URL=http://localhost:3001
BACKEND_SWAGGER_URL=http://localhost:3001/api-docs

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:3001

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=products

# ── IBM Cloud / OpenShift ─────────────────────────────────────────────────────
IBMCLOUD_API_KEY=<your-ibm-cloud-api-key>
IBM_CLOUD_RESOURCE_GROUP=<your-resource-group>

# IBM Cloud Container Registry (ICR)
ICR_REGION=us-south
ICR_NAMESPACE=<your-icr-namespace>
ICR_HOSTNAME=us.icr.io

# OpenShift cluster
ROKS_CLUSTER_NAME=<your-cluster-name>
ROKS_REGION=us-south
ROKS_WORKER_FLAVOR=cxf.8x16
ROKS_WORKER_COUNT=2
ROKS_OCP_VERSION=4.16_openshift

# OpenShift application namespace
OCP_NAMESPACE=orbital-suppliers
