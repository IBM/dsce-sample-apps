#######################################################################
# QSE Automation Workbench — environment configuration
# Copy to `.env` (next to docker-compose.yml, i.e. deployment/.env) and edit.
# Never commit the real file. Variables marked REQUIRED have no default.
#######################################################################

# ---- Secrets (REQUIRED) ---------------------------------------------
# AES-256-GCM key ring: "kid:base64(32 bytes)". The FIRST entry encrypts new data;
# the others stay available for decryption so keys can be rotated.
#   generate:  echo "k1:$(openssl rand -base64 32)"
SECRETS_KEYS=k1:RHL+PX2HBtg9UUR/7NSBdHUH8phxruul5cgaTqRHqlw=
# Bootstrap administrator (created on first start if it does not exist). >= 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD="a-long-dev-password"

# ---- Headless Bob ----------------------------------------------------
# The Bob address/API key are entered in the UI and stored encrypted; nothing here is required.
# SSRF guard: metadata/link-local/reserved addresses are always rejected. Hosts (or IP literals) in private
# or loopback ranges are rejected unless allowed. In Docker the Bob host (e.g. headless-bob) resolves to a private IP, so:
BOB_ALLOW_PRIVATE_NETWORK=true
# Optional allow-list of Bob host names (comma separated). Empty = any host that passes the SSRF checks.
BOB_ALLOWED_HOSTS=
BOB_REQUEST_TIMEOUT_MS=15000
# Development/testing only. Must stay false in production (the backend refuses to start otherwise).
# ---- Stream mode -------------------------------------------------------
# mock     (DEFAULT) Demo site: replays a RECORDED real run. Headless Bob, GitHub and the QSE CLI are never
#          contacted and the Bob address / API key / token you enter are not used. Everything is labelled DEMO.
# realtime Real Headless Bob, git clone and QSE CLI. No demo or mock data is ever served.
# A fresh install runs the demo until you set STREAM_MODE=realtime.
#STREAM_MODE=mock
STREAM_MODE=realtime

# ---- Optional bundled Headless Bob (compose profile "bob") ------------
# Image built from the Headless Bob project (see docs/DEPLOYMENT.md).
HEADLESS_BOB_IMAGE=headlessbob:latest
# Bob Shell API key — stays inside the Bob container.
BOB_API_KEY=bob_prod_bob-apikey_VMkBqge7qzKj61gMfkFDyfS38LfinZFhgKMfGH13YB3zaCeASz9pCGxm6HwH48wpJR36uqMMXPDQUEkTTdVaUpu_6g84Q3S54GYGXVBAVY4TfwrCQDeiv1XgZFRd9xCZLzR5
# Service tokens accepted by Headless Bob; the value you paste into the Workbench is one of these.
#   AUTH_TOKENS={"workbench":"<random token of at least 24 characters>"}
AUTH_TOKENS='{"workbench": "KaMZCk6Od9Hc3PgtKFkI5lLhQaTtz66RbgEExSSuihhmhrqb"}'
# Long QSE scans need more than Headless Bob's 5 minute default.
BOB_RUN_TIMEOUT_MS=1800000
# Mount modes of the shared volumes inside the Bob container (ro or rw).
BOB_WORKSPACE_MOUNT_MODE=ro
BOB_QSE_MOUNT_MODE=ro

# ---- QSE CLI ---------------------------------------------------------
# Host directory containing the QSE CLI (cli.sh / qse-cli and its libraries). It is bind-mounted
# read-only at /opt/qse-cli in BOTH the backend and Headless Bob containers.
QSE_CLI_HOST_DIR=/Users/sunilgajula/qse-cli
# Optional explicit path (as seen by the backend) used by automatic discovery.
QSE_CLI_PATH=
QSE_CLI_EXECUTABLE_NAMES=cli.sh
# Version command; unverified for your CLI build, change it if `--version` is not supported.
QSE_CLI_VERSION_ARGS=-v
QSE_VALIDATION_TIMEOUT_MS=30000
# Extra Debian package for the backend image if the CLI needs a runtime to execute --version
# (build arg, e.g. default-jre-headless). Leave empty if not needed.
BACKEND_JAVA_PACKAGE=default-jre-headless

# ---- GitHub ----------------------------------------------------------
GITHUB_ALLOWED_HOSTS=github.com
CLONE_TIMEOUT_MS=600000

# ---- Execution -------------------------------------------------------
EXECUTION_TIMEOUT_MS=1800000
MAX_CONCURRENT_EXECUTIONS=1
# Cannot exceed Headless Bob's 20000 character message limit minus the context the backend adds.
MAX_PROMPT_CHARS=8000

# ---- Web / sessions --------------------------------------------------
# Published ports of the NGINX frontend.
HTTP_PORT=8080
HTTPS_PORT=8443
# Host name used for the HTTP -> HTTPS redirect when the TLS override is used.
PUBLIC_HOST=localhost
# Browser origins allowed to call the API cross-origin. Same-origin via NGINX needs none.
CORS_ALLOWED_ORIGINS=
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
# Number of reverse proxies in front of the backend (NGINX = 1).
TRUST_PROXY=1
# false only when serving plain HTTP for local evaluation; production always forces secure cookies.
COOKIE_SECURE=false
NODE_ENV=development
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# (unused with colocated) QSE_MOUNT_DIR=/usr/local/bin/qse-cli-artifacts
# (unused with colocated) BOB_QSE_MOUNT_DIR=/opt/qse-cli
# (unused with colocated) BOB_WORKSPACE_MOUNT_DIR=/shared/workspaces
NODE_ENV=development


