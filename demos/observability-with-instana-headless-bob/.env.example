# ── Data source ──────────────────────────────────────────────────────────────
# mock   (default) – simulated Retail Application data, 5 injectable failure
#                    scenarios, canned chat/RCA. No credentials needed; nothing
#                    below this section is read.
# realtime         – live data from Instana through the MCP server. Requires the
#                    Instana, Bob and MCP settings below.
STREAM_MODE=mock

# ── Instana (required when STREAM_MODE=realtime) ─────────────────────────────
# Tenant URL, e.g. https://<tenant>-<unit>.instana.io
INSTANA_BASE_URL=https://<your-tenant>.instana.io
# Instana API token (read-only scopes are sufficient for this app)
INSTANA_API_TOKEN=<your-instana-api-token>

# Optional: application perspective used by the dashboard / Headless Bob monitor
# INSTANA_APP_NAME=Retail Application
# Optional: pin the Kubernetes cluster shown on the Infrastructure Insights tab.
# If unset, the bridge auto-selects the cluster with the highest CPU requests.
# INSTANA_K8S_CLUSTER=<kubernetes-cluster-name>

# ── Bob Inference API (required when STREAM_MODE=realtime) ───────────────────
# Create at bob.ibm.com → Account → API Keys → Scope: General or Inference
BOB_API_KEY=<your-bob-api-key>
# Bob inference base URL (US East region)
BOB_API_BASE_URL=https://api.us-east.bob.ibm.com
# Bob model name — use "premium", "fast", or "explorer"
# Discover available models: GET /inference/v1/model/info (Authorization: Apikey <key>)
BOB_MODEL=premium
# Bob instance and team IDs — fetch from: GET /admin/v1/profile (Authorization: Apikey <key>)
BOB_INSTANCE_ID=<your-bob-instance-id>
BOB_TEAM_ID=<your-bob-team-id>

# ── Instana MCP server (stdio) ───────────────────────────────────────────────
# Local development (spawned by the bridge through uvx):
INSTANA_MCP_COMMAND=uvx
INSTANA_MCP_ARGS=["mcp-instana","--transport","stdio"]
# In the container image mcp-instana is pre-installed and these are preset to
#   INSTANA_MCP_COMMAND=mcp-instana  INSTANA_MCP_ARGS=["--transport","stdio"]

# ── Bridge ───────────────────────────────────────────────────────────────────
# Local default 3001 (Vite proxies /api and /hb to it). The container uses 8080.
# PORT=3001

# ── TLS (only for corporate CAs; leave unset otherwise) ──────────────────────
# INSTANA_SSL_VERIFY=true
# INSTANA_CA_BUNDLE=/path/to/ca-bundle.pem
# SSL_CERT_FILE=/path/to/ca-bundle.pem
# REQUESTS_CA_BUNDLE=/path/to/ca-bundle.pem
