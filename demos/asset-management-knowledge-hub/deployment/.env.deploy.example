# =============================================================================
# deployment/.env.deploy.example — Template for deployment secrets
#
# Copy to .env.deploy and fill in real values.
# .env.deploy is gitignored — this example file is safe to commit.
#
# Used by all three deploy scripts:
#   deploy-ingestion.sh   — Ingestion Pipeline
#   deploy-mcp-server.sh  — MCP Server
#   deploy.sh             — Frontend UI
#   deploy-all.sh         — Full-stack orchestrator
# =============================================================================

# ── IBM Cloud ─────────────────────────────────────────────────────────────────
# IBM Cloud API key — used to log in to ibmcloud CLI and push to ICR
IBMCLOUD_API_KEY=CHANGE_ME

# ── OpenSearch (shared by Ingestion Pipeline and MCP Server) ──────────────────
OPENSEARCH_HOST=https://opensearch.<host>:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=CHANGE_ME
OPENSEARCH_INDEX=maximo-documents
OPENSEARCH_VERIFY_SSL=0

# ── IBM watsonx AI (shared by Ingestion Pipeline and MCP Server) ──────────────
WATSONX_API_KEY=CHANGE_ME
WATSONX_PROJECT_ID=CHANGE_ME
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
WATSONX_EMBEDDING_MODEL_ID=ibm/slate-30m-english-rtrvr-v2

# ── ServiceNow (MCP Server only — demo Personal Developer Instance) ──────────
SERVICENOW_INSTANCE_URL=https://<your-instance>.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=CHANGE_ME
SERVICENOW_VERIFY_SSL=1

# ── IBM Cloud Object Storage (Ingestion Pipeline only) ────────────────────────
COS_API_KEY=CHANGE_ME
COS_BUCKET_NAME=maximo-docs
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_BUCKET_INSTANCE_CRN=CHANGE_ME
COS_REGION=us-south
# HMAC credentials — optional, only needed for the S3-compatible ingestion path
COS_HMAC_ACCESS_KEY_ID=
COS_HMAC_SECRET_ACCESS_KEY=

# ── Confluent / Apache Kafka (optional — leave blank to disable) ──────────────
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_API_KEY=CHANGE_ME
KAFKA_API_SECRET=CHANGE_ME
KAFKA_TOPICS=maximo.workorders,maximo.assets,maximo.sr
KAFKA_GROUP_ID=maximo-knowledge-hub
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-1.aws.confluent.cloud
SCHEMA_REGISTRY_API_KEY=CHANGE_ME
SCHEMA_REGISTRY_API_SECRET=CHANGE_ME

# ── Spiderbot / web-knowledge index (MCP Server) ─────────────────────────────
# The OpenSearch index that the spiderbot web crawler writes to.
# Leave blank to use the default value (maximo_web_knowledge).
SPIDERBOT_INDEX=maximo_web_knowledge

# ── Frontend UI (deploy.sh) ───────────────────────────────────────────────────
# These are auto-detected from Code Engine when using deploy-all.sh.
# Set them manually here only when running deploy.sh directly.
BACKEND_API_URL=https://mcp-server.<project>.eu-de.codeengine.appdomain.cloud
INGEST_API_URL=https://ingestion-pipeline.<project>.eu-de.codeengine.appdomain.cloud
OPENSEARCH_URL=https://opensearch.<host>:9200

# ── CORS (MCP Server + Ingestion Pipeline) ────────────────────────────────────
# Set to the public URL of the deployed frontend after the first UI deploy.
# Comma-separate multiple origins. A wildcard is no longer accepted by default.
CORS_ORIGIN=https://maximo-knowledge-hub.<project>.eu-de.codeengine.appdomain.cloud

# ── API authentication (UI + MCP Server + Ingestion Pipeline) ─────────────────
# One shared secret. The backends reject any request without it (X-API-Key);
# the UI's nginx adds it to proxied calls, so it never reaches the browser.
# Letters, digits, '_' and '-' only. Generate with:  openssl rand -hex 32
API_KEY=CHANGE_ME

# ── Administrator access (UI + Ingestion Pipeline) ────────────────────────────
# Starting an ingestion job or deleting a document needs this second secret.
# The UI's nginx sends it only when the signed-in user is UI_USERNAME.
# Must differ from API_KEY. Letters, digits, '_' and '-' only.
ADMIN_API_KEY=CHANGE_ME

# ── UI login (nginx HTTP basic auth in front of the whole site) ───────────────
# UI_USERNAME is the administrator. Required. Letters, digits, '.', '_' and '-' in
# the username; no newlines in the password.
UI_USERNAME=CHANGE_ME
UI_PASSWORD=CHANGE_ME
# Optional read-only login: can search and chat, cannot ingest or delete. Set both or neither.
UI_VIEWER_USERNAME=
UI_VIEWER_PASSWORD=

# ── Outbound request controls (Ingestion Pipeline / MCP Server) ───────────────
# Approved web-crawl domains (comma-separated, "*." wildcards ok).
# Blank = the default: ibm.com, *.ibm.com, maximosecrets.com, *.maximosecrets.com
# Private/loopback/link-local/metadata/cluster-internal targets are always refused.
CRAWL_ALLOWED_HOSTS=
# Hosts that may be registered as Maximo instances (blank = any non-link-local host).
MAXIMO_ALLOWED_HOSTS=
# Extra S3-compatible endpoints a caller may select (the configured COS_ENDPOINT is always allowed).
S3_ALLOWED_ENDPOINTS=

# ── Maximo Manage (MCP Server only — optional) ────────────────────────────────
MAXIMO_URL=https://<your-maximo-host>/maximo/oslc
MAXIMO_API_KEY=CHANGE_ME
MAXIMO_USERNAME=maxadmin
MAXIMO_PASSWORD=CHANGE_ME
MAXIMO_TIMEOUT=30
MAXIMO_VERIFY_SSL=false
